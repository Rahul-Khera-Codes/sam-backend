# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── LiveKit ───────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ── OpenAI ────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── LangSmith tracing (HR Employee Chatbot) ───
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=hr-employee-chatbot
# LANGSMITH_WORKSPACE_ID=your-workspace-id

# ── AWS S3 (optional) ─────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-recordings-bucket

# ── Google Calendar OAuth ─────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Enable: Google Calendar API
# Authorised redirect URI: http://localhost:5173/integrations/google/callback (and your prod URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations/google/callback

# ── Microsoft Outlook OAuth ────────────────────
# Create at: https://portal.azure.com → Microsoft Entra ID → App registrations
# API permissions (Microsoft Graph, Delegated): Mail.Send, offline_access, User.Read — admin consent granted
# Redirect URI (Web platform) — register BOTH in Azure, must match exactly (AIE-34):
#   local: http://localhost:5173/integrations/outlook/callback
#   prod:  https://portal.aiemployeesinc.com/integrations/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:5173/integrations/outlook/callback

# ── Twilio Phone / SIP ────────────────────────────────────
# Run scripts/setup_sip_trunks.py once to generate all values below
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_TRUNK_SID=                          # filled by setup script
LIVEKIT_SIP_INBOUND_TRUNK_ID=              # filled by setup script
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=             # filled by setup script
LIVEKIT_SIP_HOST=                          # from LiveKit Cloud dashboard → Project Settings → SIP URI (e.g. sip:abc123.sip.livekit.cloud)
AGENT_NAME=ai-employee-agent               # must match AGENT_NAME in agent/.env.local
SIP_AUTH_USERNAME=                         # filled by setup script
SIP_AUTH_PASSWORD=                         # filled by setup script
TWILIO_TERM_SIP_USERNAME=                  # filled by setup script
TWILIO_TERM_SIP_PASSWORD=                  # filled by setup script
TWILIO_TERM_DOMAIN=                        # filled by setup script

# ── App ───────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://your-lovable-app.com

#STRIPE
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_SECRET_KEY=
STRIPE_STARTER_PRICE_ID=                   # $249/mo Price ID (price_..., NOT the product id) — create in Stripe Dashboard
STRIPE_GROWTH_PRICE_ID=                    # $499/mo Price ID (price_..., NOT the product id) — create in Stripe Dashboard
STRIPE_ENTERPRISE_PRICE_ID=                # $999/mo Price ID (price_..., NOT the product id) — create in Stripe Dashboard
STRIPE_EXEC_AGENT_PRICE_ID=  # created in Stripe dashboard once Sam names a price — see docs/adr/0001-billing-addon-access-gating.md
EXEC_AGENT_ADDON_ENFORCED=false  # set true once ready to actually block non-payers — free during beta by default
BILLING_SUCCESS_URL=https://portal.aiemployeesinc.com/dashboard/settings/billing?success=true
BILLING_CANCEL_URL=https://portal.aiemployeesinc.com/dashboard/settings/billing

# Minute caps per plan (tunable without a redeploy) and trial length — see docs/features/billing-pricing-page.md
PLAN_STARTER_MINUTE_LIMIT=800
PLAN_GROWTH_MINUTE_LIMIT=1500
# PLAN_ENTERPRISE_MINUTE_LIMIT=            # leave unset for unlimited (default) — set a number to cap it
PLAN_TRIAL_MINUTE_LIMIT=60
TRIAL_PERIOD_DAYS=14

# ── Apify (Sales Employee — Lead Researcher + Competitor Agent) ──
APIFY_API_TOKEN=                           # from Apify Console → Settings → Integrations
APIFY_WEBHOOK_BASE_URL=                    # this backend's public URL, e.g. https://api.yourdomain.com — use ngrok locally to test the webhook round-trip
APIFY_WEBHOOK_SECRET=                      # any random string — checked on inbound webhook calls so randoms can't spoof "run finished" events

# ── YouTube Data API v3 (Sales Employee — Competitor Agent) ──
YOUTUBE_API_KEY=                           # Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key (plain key, not OAuth)

# ── Exa.ai (Sales Employee — Market Agent) ──
EXA_API_KEY=                               # from dashboard.exa.ai — sent via x-api-key header, not Authorization

# ── LinkedIn (Marketing Employee) — personal-profile posting live (AIE-32) ──
# App created at https://www.linkedin.com/developers/apps with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect" products.
# Authorized redirect URL on the LinkedIn app's Auth tab must be: https://portal.aiemployeesinc.com/integrations/marketing/linkedin/callback (note the /marketing/ segment)
MARKETING_LINKEDIN_CLIENT_ID=
MARKETING_LINKEDIN_CLIENT_SECRET=
MARKETING_LINKEDIN_REDIRECT_URI_LOCAL=http://localhost:8080/integrations/marketing/linkedin/callback
MARKETING_LINKEDIN_REDIRECT_URI_PRODUCTION=
MARKETING_LINKEDIN_API_VERSION=202502      # LinkedIn-Version header (YYYYMM) — bump to whatever's current when this is first tested
MARKETING_LINKEDIN_ORGANIZATION_ACCESS_ENABLED=false # flip to true once Sam's app has the "Community Management API" product approved (AIE-100) — unlocks Company Page posting